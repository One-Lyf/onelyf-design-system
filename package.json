{
  "name": "onelyf-design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OneLyf + Liv design system — brand tokens, Root Glyph, and presentational components. Single brand source the Lyf apps inherit.",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/onelyf-design-system.js",
  "module": "./dist/onelyf-design-system.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/onelyf-design-system.js"
    },
    "./tokens": "./src/tokens.ts",
    "./spend": {
      "types": "./dist/spend/index.d.ts",
      "import": "./dist/spend/index.js",
      "default": "./dist/spend/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:spend",
    "build:lib": "vite build && npm run build:spend",
    "build:spend": "tsc -p tsconfig.spend.json",
    "prepare": "vite build && npm run build:spend",
    "preview": "vite preview",
    "test": "node --test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
